# Required for database migrations and the idempotent demo seed.
DATABASE_URL=postgresql://user:password@host:5432/database

# Canonical URLs default safely for local development.
NEXT_PUBLIC_SITE_URL=https://gobiverse.com

# Analytics stays disabled until a real ID is supplied.
NEXT_PUBLIC_ANALYTICS_ID=

# Optional future affiliate configuration; no checkout is enabled in foundation.
AFFILIATE_NETWORK=